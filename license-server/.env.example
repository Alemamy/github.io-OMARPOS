# Cloud deployment environment variables
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DATABASE_SSL=true
ADMIN_USERNAME=omaradmin
ADMIN_PASSWORD_HASH=$2b$12$REPLACE_WITH_A_BCRYPT_HASH
# For production, replace * with your exact OmarPOS client origin if applicable.
CORS_ORIGIN=*
PORT=8787
